# Copy to .env in this folder and fill in (never commit .env).
#   cp .env.example .env && nano .env

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_KEY=

# First start on an empty database creates admin@4ume.io.vn with this password.
# Log in, change it in the admin, then clear this line.
ADMIN_INITIAL_PASSWORD=

# Free API keys for the admin's photo search (optional): https://www.pexels.com/api/ · https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Sign-up and password-reset codes are mailed from noreply@4ume.io.vn through https://resend.com
# (verify the domain there first). Without a key the codes are only printed in the API log.
RESEND_API_KEY=
# Where replies to those mails go, e.g. hotro@4ume.io.vn (optional).
EMAIL_REPLY_TO=

# Listening audio (Góc nghe) is generated with Azure Speech, free tier F0 (0.5M characters/month):
# portal.azure.com → Create "Speech service" → Pricing tier F0 → Keys and Endpoint (key 1 + region, e.g. southeastasia).
# Without a key the app reads the scripts with the phone's own voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# AI drafting (listening, grammar, placement) can use Google Gemini (free tier): aistudio.google.com → Get API key.
# GEMINI_MODEL is optional (default gemini-flash-latest).
GEMINI_API_KEY=
GEMINI_MODEL=
# Tried in order when GEMINI_MODEL is overloaded (default gemini-flash-lite-latest,gemini-2.5-flash).
GEMINI_FALLBACK_MODELS=
# Groq (free tier, console.groq.com → API Keys) drafts first when set; Gemini is then only the fallback.
# GROQ_MODEL default openai/gpt-oss-120b; GROQ_FALLBACK_MODELS default openai/gpt-oss-20b (console.groq.com/docs/models).
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODELS=

# Image version to run: "latest" or a commit, e.g. sha-02144f7c… (to pin or roll back).
IMAGE_TAG=latest
