# Copy to .env on the VPS and fill in (never commit .env).
#   cp .env.example .env && nano .env

# Domains pointing (DNS A record) to the VPS IP. Caddy requests HTTPS certificates for both.
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=you@example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_KEY=

# First start on an empty database creates admin@4ume.io.vn with this password.
# Log in, change it in the admin, then clear this line.
ADMIN_INITIAL_PASSWORD=

# Free API keys for the admin's photo search (optional): https://www.pexels.com/api/ · https://pixabay.com/api/docs/
# For local development, a .env with just these two lines works with docker-compose.yml too.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Sign-up and password-reset codes are mailed from noreply@4ume.io.vn through https://resend.com
# (verify the domain there first). Without a key the codes are only printed in the API log.
RESEND_API_KEY=
# Where replies to those mails go, e.g. hotro@4ume.io.vn (optional).
EMAIL_REPLY_TO=
