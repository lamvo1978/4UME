{
  "expo": {
    "name": "4UME",
    "slug": "fourume",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E7F2EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fourume.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.fourume.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "4UME dùng micro để chấm phát âm khi bạn đọc to từ vựng.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "4UME cần truy cập ảnh để bạn đính kèm ảnh chụp màn hình khi gửi góp ý.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
