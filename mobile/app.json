{
  "expo": {
    "name": "4UME",
    "slug": "fourume",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fourume.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "4UME chuyển câu bạn nói thành chữ để so với câu mẫu khi luyện nói và để bạn trò chuyện với AI.",
        "NSMicrophoneUsageDescription": "4UME dùng micro để chấm phát âm và để bạn luyện nói."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.fourume.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "4UME dùng micro để chấm phát âm và để bạn luyện nói.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "4UME cần truy cập ảnh để bạn đính kèm ảnh chụp màn hình khi gửi góp ý.",
          "cameraPermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E7F2EC"
        }
      ],
      "@sentry/react-native",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "4UME dùng micro để chấm phát âm và để bạn luyện nói.",
          "speechRecognitionPermission": "4UME chuyển câu bạn nói thành chữ để so với câu mẫu khi luyện nói và để bạn trò chuyện với AI."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3892770660039931~3489525077",
          "iosAppId": "ca-app-pub-3892770660039931~5672835286",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "4UME chỉ có quảng cáo khi bạn tự chọn xem để thêm lượt chấm, và một banner nhỏ ở Trang chủ. Cho phép để quảng cáo hợp với bạn hơn; không cho phép thì bạn vẫn thấy số quảng cáo như vậy."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "7562124a-994f-4661-aba3-3cee57af0c30"
      }
    },
    "owner": "lamvo1978",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7562124a-994f-4661-aba3-3cee57af0c30"
    }
  }
}
