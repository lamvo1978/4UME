      "type": "usage",
      "items": [
        { "textVi": "Giới thiệu tên, nghề nghiệp, quốc tịch.", "example": { "en": "I am a student.", "vi": "Tôi là học sinh." } },
        { "textVi": "Miêu tả tính chất, cảm xúc (đi với tính từ).", "example": { "en": "She is happy.", "vi": "Cô ấy vui." } },
        { "textVi": "Nói vị trí, nơi chốn.", "example": { "en": "They are at school.", "vi": "Họ đang ở trường." } },
        { "textVi": "Nói tuổi: tiếng Anh dùng to be, không dùng have.", "example": { "en": "He is ten years old.", "vi": "Cậu ấy mười tuổi." } }
      ]
