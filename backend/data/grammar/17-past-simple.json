  "summaryVi": "Diễn tả việc đã xảy ra và kết thúc trong quá khứ. Động từ có quy tắc thêm -ed, bất quy tắc phải học thuộc (go → went).",
  "quizSize": 8,
  "sections": [
    {
      "type": "usage",
      "items": [
        { "textVi": "Việc đã xảy ra và kết thúc tại thời điểm xác định trong quá khứ.", "example": { "en": "I visited Hue last year.", "vi": "Năm ngoái tôi đã đến Huế." } },
        { "textVi": "Chuỗi hành động nối tiếp trong quá khứ.", "example": { "en": "He got up, had breakfast and left.", "vi": "Anh ấy thức dậy, ăn sáng rồi đi." } }
      ]
    },
    {
      "type": "formula",
      "rows": [
        { "kind": "affirmative", "pattern": "S + V-ed / V2 (bất quy tắc)", "example": { "en": "She went to Paris.", "vi": "Cô ấy đã đến Paris." } },
        { "kind": "negative", "pattern": "S + did not (didn't) + V nguyên mẫu", "example": { "en": "We didn't see him.", "vi": "Chúng tôi không thấy anh ấy." } },
        { "kind": "question", "pattern": "Did + S + V nguyên mẫu?", "example": { "en": "Did you call her?", "vi": "Bạn có gọi cho cô ấy không?" } },
        { "kind": "short-answer", "pattern": "Yes, S + did. / No, S + didn't.", "example": { "en": "Yes, I did.", "vi": "Có." } },
        { "kind": "note", "pattern": "to be: I / He / She / It + was · You / We / They + were", "example": { "en": "They were at home.", "vi": "Họ đã ở nhà." } }
      ]
    },
    {
      "type": "table",
      "title": "Cách thêm -ed",
      "headers": ["Quy tắc", "Ví dụ"],
      "cells": [
        ["Thông thường: + ed", "work → worked, play → played"],
        ["Tận cùng e: + d", "live → lived, like → liked"],
        ["Phụ âm + y: y → ied", "study → studied, cry → cried"],
        ["1 âm tiết, 1 nguyên âm + 1 phụ âm: gấp đôi phụ âm (trừ w, x, y)", "stop → stopped, plan → planned; nhưng fix → fixed"]
      ]
    },
    {
      "type": "table",
      "title": "Động từ bất quy tắc hay gặp",
      "headers": ["Nguyên mẫu", "Quá khứ", "Nghĩa"],
      "cells": [
        ["go", "went", "đi"],
        ["have", "had", "có"],
        ["see", "saw", "thấy"],
        ["buy", "bought", "mua"],
        ["eat", "ate", "ăn"],
        ["take", "took", "lấy, mang"],
        ["make", "made", "làm"],
        ["write", "wrote", "viết"],
        ["come", "came", "đến"],
        ["get", "got", "nhận, được"]
      ]
    },
    { "type": "signals", "words": ["yesterday", "last night", "last week", "two days ago", "in 2019", "when I was young"] },
    {
      "type": "mistakes",
