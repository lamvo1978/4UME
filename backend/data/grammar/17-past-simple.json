        { "wrong": "Did you saw it?", "right": "Did you see it?", "noteVi": "Sau did dùng động từ nguyên mẫu." },
        { "wrong": "She didn't went.", "right": "She didn't go.", "noteVi": "Sau didn't dùng động từ nguyên mẫu." }
      ]
