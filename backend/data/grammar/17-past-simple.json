  "exercises": [
    { "id": "pa-01", "type": "mcq", "prompt": "We ___ a great film last night.", "options": ["see", "saw", "seen"], "answer": "saw", "explanationVi": "last night → quá khứ; see → saw." },
    { "id": "pa-02", "type": "mcq", "prompt": "___ you go to the party yesterday?", "options": ["Do", "Did", "Were"], "answer": "Did", "explanationVi": "Câu hỏi quá khứ với động từ thường: Did + S + V." },
    { "id": "pa-03", "type": "mcq", "prompt": "They ___ at the cinema on Sunday.", "options": ["was", "were", "did"], "answer": "were", "explanationVi": "They + were." },
    { "id": "pa-04", "type": "mcq", "prompt": "Chọn câu đúng.", "options": ["She didn't called me.", "She didn't call me.", "She not called me."], "answer": "She didn't call me.", "explanationVi": "didn't + V nguyên mẫu." },
    { "id": "pa-05", "type": "mcq", "prompt": "Quá khứ của 'buy' là:", "options": ["buyed", "bought", "brought"], "answer": "bought", "explanationVi": "buy → bought (brought là quá khứ của bring)." },
    { "id": "pa-06", "type": "fill", "prompt": "I ___ (play) football yesterday.", "answers": ["played"], "explanationVi": "Có quy tắc: play → played." },
    { "id": "pa-07", "type": "fill", "prompt": "She ___ (go) to Japan in 2019.", "answers": ["went"], "explanationVi": "go → went." },
    { "id": "pa-08", "type": "fill", "prompt": "We ___ (not / have) time to eat.", "answers": ["didn't have", "did not have"], "explanationVi": "didn't + V nguyên mẫu." },
    { "id": "pa-09", "type": "fill", "prompt": "The weather ___ (be) terrible last weekend.", "answers": ["was"], "explanationVi": "The weather = it → was." },
    { "id": "pa-10", "type": "order", "promptVi": "Tôi đã mua một chiếc xe đạp mới tuần trước.", "answer": "I bought a new bike last week.", "distractors": ["buy"], "explanationVi": "buy → bought." },
    { "id": "pa-11", "type": "order", "promptVi": "Hôm qua bạn đã làm gì?", "answer": "What did you do yesterday?", "distractors": ["done"], "explanationVi": "Từ để hỏi + did + S + V?" },
    { "id": "pa-12", "type": "transform", "instructionVi": "Chuyển sang câu hỏi", "source": "He wrote a letter.", "answer": "Did he write a letter?", "distractors": ["wrote"], "explanationVi": "Did + S + V nguyên mẫu (write)." },
    { "id": "pa-13", "type": "transform", "instructionVi": "Chuyển sang câu phủ định", "source": "They came home late.", "answer": "They didn't come home late.", "distractors": ["came"], "explanationVi": "didn't + come." },
    { "id": "pa-14", "type": "error", "sentence": "My dad [taked] me to the zoo.", "correction": "took", "explanationVi": "take → took." },
